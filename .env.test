# Test environment. Committed on purpose so `pnpm test` passes on a clean clone.
#
# Vitest runs with mode=test, so Vite loads this file and exposes VITE_* vars on
# import.meta.env. src/js/nav-button.pro.js reads VITE_PRO_API_BASE at call time;
# without it the Pro nav button test fails on `apiBase.replace` of undefined.
#
# This holds no credentials. The value is a localhost placeholder: the tests mock
# fetch and never open a socket, they only assert on the URL that gets built.
VITE_PRO_API_BASE=http://localhost:8787
